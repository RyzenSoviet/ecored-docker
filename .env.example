# Con Docker: host.docker.internal si MySQL corre en este mismo equipo, o la IP/nombre del servidor MySQL.
# Sin Docker: 127.0.0.1 si MySQL corre en este mismo equipo.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=ecored
DB_USER=ecored
DB_PASSWORD=replace-with-your-database-password
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=replace-with-a-random-key-at-least-32-characters
